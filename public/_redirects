# Short aliases for the GrammarLens legal pages.
# The addresses under /products/ are the real ones; these only catch
# anyone who typed or linked the short form. Server-side 301, not a
# client-side redirect, so Apple's review team lands on real content.
/grammarlens          /products/grammarlens          301
/grammarlens/privacy  /products/grammarlens/privacy  301
/grammarlens/terms    /products/grammarlens/terms    301
/grammarlens/support  /products/grammarlens/support  301

# Short addresses for the BirdPerch legal pages. The app's paywall and
# settings link to /birdperch/{privacy,terms,support}; there is no product
# page, so /birdperch itself goes to support. Rules match the path
# exactly, so each one is listed with and without the trailing slash.
/birdperch             /products/birdperch/support/   301
/birdperch/            /products/birdperch/support/   301
/birdperch/privacy     /products/birdperch/privacy/   301
/birdperch/privacy/    /products/birdperch/privacy/   301
/birdperch/terms       /products/birdperch/terms/     301
/birdperch/terms/      /products/birdperch/terms/     301
/birdperch/support     /products/birdperch/support/   301
/birdperch/support/    /products/birdperch/support/   301
