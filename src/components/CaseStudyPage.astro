---
// The GrammarLens case study, shared by the English and Turkish routes.
// Astro.currentLocale picks the language — see src/content/caseStudy.js.
//
// The two languages render differently: English is the v2 case study,
// built from typed blocks (brief: docs/grammarlens-case-study-v2.md);
// Turkish keeps the earlier MVP-only text in its original markup, with a
// notice at the top pointing to the English page.
//
// The legal pages this links out to (privacy/terms/support) stay
// English-only, so this page never links to them; it only links back to
// the product page, in whichever language that page exists.
import Base from '../layouts/Base.astro';
import Reframe from './case-study/Reframe.astro';
import Timeline from './case-study/Timeline.astro';
import ModelCalls from './case-study/ModelCalls.astro';
import FreeCostBars from './case-study/FreeCostBars.astro';
import CapChart from './case-study/CapChart.astro';
import TokenBudget from './case-study/TokenBudget.astro';
import Storyboard from './case-study/Storyboard.astro';
import Screenshot from './case-study/Screenshot.astro';
import { caseStudyCopy } from '../content/caseStudy.js';
import { localizeHref } from '../i18n.js';

const lang = Astro.currentLocale ?? 'en';
const t = caseStudyCopy[lang];
const productHref = localizeHref('/products/grammarlens', lang);

// Charts, diagrams and screenshots, by the name a { type: 'figure' } block
// uses; their props come from t.figures under the same name. A name
// missing from this map renders nothing, so copy can mark a figure's place
// before the figure exists.
//
// Every figure takes one of exactly two positions (brief, Part E12):
// wide spans both grid columns, from the aside's left edge to the body
// text's right edge; narrow sits in the body column, flush with the text.
const figures = {
  timeline: { component: Timeline, wide: true },
  modelCalls: { component: ModelCalls, wide: true },
  capMath: { component: CapChart, wide: true },
  storyboard: { component: Storyboard, wide: true },
  freeCost: { component: FreeCostBars, wide: false },
  tokenBudget: { component: TokenBudget, wide: false },
  offerCard: { component: Screenshot, wide: false },
  explanation: { component: Screenshot, wide: false },
};

// Splits a block list into runs of prose and the figures between them.
// Prose runs become .body columns; figures sit between them as their own
// grid items, placed by the rule above.
function group(blocks) {
  const groups = [];
  for (const block of blocks) {
    if (block.type === 'figure') {
      if (figures[block.name]) groups.push({ figure: block.name });
    } else if (groups.length && groups.at(-1).blocks) {
      groups.at(-1).blocks.push(block);
    } else {
      groups.push({ blocks: [block] });
    }
  }
  return groups;
}

// One .row per entry: the summary (no heading of its own, so its aside
// label names it) and then the numbered sections.
const rows =
  lang === 'en'
    ? [
        { label: t.summary.label, id: 'summary', groups: group(t.summary.blocks) },
        ...t.sections.map((section, i) => ({
          label: section.label,
          heading: section.heading,
          id: `section-${i + 1}`,
          groups: group(section.blocks),
        })),
      ]
    : [];
---

<Base title={t.meta.title} description={t.meta.description}>
  {
    lang === 'en' ? (
      <>
        <section class="row v2">
          <aside class="note">
            <strong>{t.aside.label}</strong>
            {t.aside.lines.map((line) => (
              <span class="note-line">{line}</span>
            ))}
            <span class="note-status">{t.aside.status}</span>
            <span class="note-updated">{t.aside.updated}</span>
          </aside>
          <div class="body">
            <h1 class="display">{t.title}</h1>
            <p class="lede">{t.subtitle}</p>
            <p>
              <a class="tap-link" href={productHref}>{t.backLinkText}</a>
            </p>
          </div>
        </section>

        {rows.map((row, ri) => (
          <section class="row v2" aria-labelledby={row.heading ? row.id : `${row.id}-label`}>
            <aside class="note">
              <strong id={row.heading ? undefined : `${row.id}-label`}>{row.label}</strong>
            </aside>
            {row.groups.map((g, gi) => {
              if (g.figure) {
                const { component: Figure, wide } = figures[g.figure];
                return (
                  <div class={wide ? 'fig fig-wide' : 'fig fig-narrow'}>
                    <Figure {...t.figures[g.figure]} />
                  </div>
                );
              }
              const isPageEnd = ri === rows.length - 1 && gi === row.groups.length - 1;
              return (
                <div class="body">
                  {gi === 0 && row.heading && <h2 id={row.id}>{row.heading}</h2>}
                  {g.blocks.map((b) =>
                    b.type === 'p' ? (
                      <p set:html={b.html} />
                    ) : b.type === 'h3' ? (
                      <h3>{b.text}</h3>
                    ) : b.type === 'reframe' ? (
                      <Reframe first={b.first} actual={b.actual} />
                    ) : b.type === 'ol' ? (
                      <ol>
                        {b.items.map((item) => (
                          <li set:html={item} />
                        ))}
                      </ol>
                    ) : null
                  )}
                  {isPageEnd && (
                    <p>
                      <a class="tap-link" href={productHref}>{t.endLinkText}</a>
                    </p>
                  )}
                </div>
              );
            })}
          </section>
        ))}
      </>
    ) : (
      <>
        <section class="row">
          <aside class="note">
            <strong>{t.aside.label}</strong>
            {t.aside.lines[0]}
            <br />
            {t.aside.lines[1]}
            <br />
            {t.aside.lines[2]}
          </aside>
          <div class="body">
            <p class="notice">
              {t.notice.before}<a href={t.notice.href} hreflang="en">{t.notice.linkText}</a>{t.notice.after}
            </p>
            <h1 class="display">{t.title}</h1>
            {t.lede.map((p) => (
              <p class="lede" set:html={p} />
            ))}
            <p>
              <a class="tap-link" href={productHref}>{t.backLinkText}</a>
            </p>
          </div>
        </section>

        <section class="row">
          <aside class="note">
            <strong>{t.section1.asideLabel}</strong>
            {t.section1.asideLines[0]}
            <br />
            {t.section1.asideLines[1]}
          </aside>
          <div class="body">
            <h2>{t.section1.heading}</h2>
            {t.section1.paragraphs.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        </section>

        <section class="row">
          <aside class="note">
            <strong>{t.section2.asideLabel}</strong>
            {t.section2.asideLines[0]}
            <br />
            {t.section2.asideLines[1]}
          </aside>
          <div class="body">
            <h2>{t.section2.heading}</h2>
            {t.section2.intro.map((p) => (
              <p set:html={p} />
            ))}
            <ul>
              {t.section2.list.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
            {t.section2.after.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        </section>

        <section class="row">
          <aside class="note">
            <strong>{t.section3.asideLabel}</strong>
            {t.section3.asideLines[0]}
            <br />
            {t.section3.asideLines[1]}
          </aside>
          <div class="body">
            <h2>{t.section3.heading}</h2>
            {t.section3.retroPoints.map((p) => (
              <p class="retro-point" set:html={p} />
            ))}
            <p set:html={t.section3.closing} />
            <p>
              <a class="tap-link" href={productHref}>{t.section3.endLinkText}</a>
            </p>
          </div>
        </section>
      </>
    )
  }
</Base>

<style>
  /* Reading rhythm for this one long-form page. Astro scopes this style to
     the elements rendered by this component only (via its own
     data-astro-cid attribute), so it cannot reach the legal pages, the home
     page, or any other page that also uses .row/.body/.lede. Spacing and
     measure only — no new color, font, or element. Applies the same way
     regardless of language, since it's pure structure.

     Each section here is one .row, with exactly one h2 at the very top of
     its .body. So "space above the heading" is the row's own top padding
     (shared with the previous row's bottom padding across the divider),
     and "space below the heading" is the gap to the paragraph right after
     it — pulling those apart, rather than fighting the grid, is what makes
     the asymmetry in requirement 3 actually work. */

  .body {
    max-width: 66ch;
  }

  /* Paragraph rhythm: clearly more than the 1.65 line-height, not just a
     hair more. */
  .body > :global(*) + :global(*) {
    margin-top: 1.75em;
  }

  /* h2 sits close to what follows it... */
  .body > h2 {
    margin-top: 0;
  }

  .body > h2 + :global(*) {
    margin-top: 0.85em;
  }

  /* ...and far from what came before it — most of the pause between
     sections now lives in the top padding of the section that's starting,
     not the bottom padding of the one that just ended. */
  .row {
    padding-top: clamp(56px, 8vw, 100px);
    padding-bottom: clamp(20px, 2.5vw, 32px);
  }

  .row:first-of-type {
    padding-top: clamp(26px, 3.5vw, 44px);
  }

  /* Intro paragraphs read as an intro: a size step up from body text, and
     heavier, not just "the same paragraph in a lighter color." */
  .lede {
    font-size: 19px;
    font-weight: 500;
  }

  /* The cost list gets more room than a paragraph break, on both sides,
     and its own items get to breathe. */
  .body ul {
    margin-top: 2.4em;
    margin-bottom: 2.4em;
  }

  .body ul + :global(*) {
    margin-top: 2.4em;
  }

  .body li + li {
    margin-top: 0.6em;
  }

  /* The four bold-led retrospective points are separate ideas — a bit more
     air between them than a normal paragraph gap. The gap from the heading
     to the first one stays governed by ".body > h2 + *" above. */
  .retro-point + .retro-point {
    margin-top: 2.2em;
  }

  /* "Back to the product" / "Product page" are plain inline text links —
     an invisible tap-target expansion rather than real padding, so the
     surrounding paragraph spacing doesn't move. */
  .tap-link {
    position: relative;
  }

  .tap-link::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: max(44px, 100%);
    height: 44px;
    transform: translateY(-50%);
  }

  /* 768px matches the one shared breakpoint used site-wide (site.css,
     HomePage.astro) — this used to be 760px, which happened to be close
     enough to the sitewide 860/760 mismatch to hide it, but the two are
     now the same value everywhere on purpose. */
  @media (max-width: 768px) {
    .row {
      padding-top: clamp(36px, 9vw, 56px);
    }

    .body > :global(*) + :global(*) {
      margin-top: 1.4em;
    }

    .body > h2 + :global(*) {
      margin-top: 0.7em;
    }

    .body ul,
    .body ul + :global(*) {
      margin-top: 1.8em;
    }

    .retro-point + .retro-point {
      margin-top: 1.6em;
    }
  }

  /* ---------- v2 (English) ----------
     Rules below only reach rows marked .v2, so the Turkish page keeps the
     look it had. */

  /* No scroll-triggered entrance on this page (brief, Part A2). Base.astro
     still arms the reveal on every .row site-wide; this puts rows back to
     their resting state here and drops the transition. */
  :global(.motion) .row {
    opacity: 1;
    transform: none;
    transition: none;
  }

  /* Aside labels name their section: sentence case, as written in the
     copy, at 20px (Nocturne's h4 step), above the 16px body text and
     below the section's own h2. The header aside's meta lines keep the
     .note's 12px, so they never read as headings. */
  .v2 .note strong {
    margin-bottom: 10px;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  /* Share the h2's first line box, so label and heading start on one
     line. */
  @media (min-width: 769px) {
    .v2 .note strong {
      padding-top: 3px;
    }
  }

  .note-line,
  .note-status,
  .note-updated {
    display: block;
  }

  .note-status {
    margin-top: 12px;
    color: var(--color-accent-300);
  }

  .note-updated {
    margin-top: 8px;
  }

  .v2 .lede {
    color: var(--color-neutral-200);
  }

  /* Left-aligned, unhyphenated text on this page. site.css justifies
     .body p site-wide; that stays as it is for the other pages. */
  .v2 .body p,
  .v2 .body li {
    text-align: left;
    hyphens: none;
  }

  /* ---------- figures ----------
     The grid's own column widths, named so the wide figures can match
     them: the aside column and gap come from site.css's .row, the measure
     from .body above. */
  .v2 {
    --aside-w: 168px;
    --col-gap: clamp(20px, 4vw, 48px);
    --measure: 66ch;
    /* Space above and below every figure: two steps of Nocturne's
       largest spacing token (2 × 22.4px). */
    --figure-space: calc(var(--space-8) * 2);
    column-gap: var(--col-gap);
    row-gap: 0;
  }

  .fig {
    min-width: 0;
    margin-block: var(--figure-space);
  }

  /* Two figures in a row share one gap instead of stacking both margins. */
  .fig + .fig {
    margin-top: 0;
  }

  .fig:last-child {
    margin-bottom: 0;
  }

  .fig-narrow {
    max-width: var(--measure);
  }

  /* Prose runs and narrow figures sit in the second column; wide figures
     span both, stopping at the body text's right edge. Only above the
     shared 768px breakpoint, where there are two columns to span. */
  @media (min-width: 769px) {
    .v2 > .body,
    .v2 > .fig-narrow {
      grid-column: 2;
    }

    .v2 > .fig-wide {
      grid-column: 1 / -1;
      max-width: calc(var(--aside-w) + var(--col-gap) + var(--measure));
    }
  }

  @media (max-width: 768px) {
    .v2 > .note {
      margin-bottom: 14px;
    }
  }

  /* Subsections within a numbered section. */
  .v2 .body > h3 {
    margin-top: 2.8em;
    font-size: 20px;
  }

  .v2 .body > h3 + :global(*) {
    margin-top: 1em;
  }

  /* Bold lead-ins ("How I'll know.") come from set:html, so they need
     :global to be styled at all. */
  .v2 .body p :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Provenance tag: .tag .tag-neutral from Nocturne, sized to sit in a
     line of body text without pushing the line apart. */
  .v2 .body :global(.prov) {
    display: inline-block;
    padding: 0 7px;
    margin-inline: 1px;
    font-size: 12px;
    line-height: 1.6;
    vertical-align: 0.08em;
    white-space: nowrap;
  }

  /* Only the bottom margin: the top one comes from the paragraph rhythm
     (.body > * + *) like every other block. */
  .v2 .body ol {
    margin-bottom: 0;
    padding-left: 1.5em;
    color: var(--color-neutral-300);
  }

  .v2 .body ol li + li {
    margin-top: 0.6em;
  }

  .v2 .body ol li::marker {
    color: var(--color-neutral-500);
  }

  /* ---------- Turkish notice ---------- */

  .notice {
    font-size: 14px;
    color: var(--color-neutral-400) !important;
    text-align: left !important;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-divider);
  }

  @media (max-width: 768px) {
    .v2 .body > h3 {
      margin-top: 2.2em;
    }
  }
</style>
