---
// The /products listing page, shared by the English and Turkish routes.
// Astro.currentLocale picks the language — see src/content/products.js.
import Base from '../layouts/Base.astro';
import { productsCopy } from '../content/products.js';
import { scanstash } from '../data.js';
import { localizeHref } from '../i18n.js';

const lang = Astro.currentLocale ?? 'en';
const t = productsCopy[lang];
---

<Base title={t.meta.title} description={t.meta.description}>
  <section class="row">
    <aside class="note">
      <strong>{t.intro.note.label}</strong>
      {t.intro.note.line1}<br />
      {t.intro.note.line2}
    </aside>
    <div class="body">
      <h1 class="display">{t.intro.title}</h1>
      <p class="lede">{t.intro.lede}</p>
    </div>
  </section>

  <section class="row">
    <aside class="note">
      <strong>{t.grammarlensEntry.note.label}</strong>
      {t.grammarlensEntry.note.line1}<br />
      {t.grammarlensEntry.note.line2}
    </aside>
    <div class="body">
      <a class="card" href={localizeHref('/products/grammarlens', lang)}>
        <span class="card-title">{t.grammarlensEntry.cardTitle}</span>
        <span class="card-text">{t.grammarlensEntry.cardText}</span>
        <span class="card-status">{t.grammarlensEntry.cardStatus}</span>
      </a>
    </div>
  </section>

  <section class="row">
    <aside class="note">
      <strong>{t.scanstashEntry.note.label}</strong>
      {t.scanstashEntry.note.line1}<br />
      {t.scanstashEntry.note.line2}
    </aside>
    <div class="body">
      <!-- No product page yet: same card, but not a link. -->
      <div class="card card-static">
        <span class="card-title card-title-icon">
          <picture>
            <source srcset={scanstash.icon.webp} type="image/webp" />
            <img src={scanstash.icon.png} alt="" width="40" height="40" loading="lazy" />
          </picture>
          {t.scanstashEntry.cardTitle}
        </span>
        <span class="card-text">{t.scanstashEntry.cardText}</span>
        <span class="card-status">{t.scanstashEntry.cardStatus}</span>
      </div>
      <p class="card-docs">
        {t.scanstashEntry.docs.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={localizeHref(l.href, lang)}>{l.label}</a>
          </>
        ))}
      </p>
    </div>
  </section>
</Base>

<style>
  /* Same look as a.card in site.css, for a product with no page yet: not a
     link, so no hover state. Kept here rather than in site.css so the
     shared stylesheet the legal pages load doesn't change. */
  .card-static {
    padding: clamp(18px, 2.2vw, 26px);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
  }

  .card-title-icon {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-title-icon img {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }

  /* Legal links under a card that has no page of its own. 13px text, but
     each link is 44px tall to tap. */
  .card-docs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--color-neutral-500);
  }

  .card-docs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-neutral-400);
  }

  .card-docs a:hover {
    color: var(--color-accent-300);
  }
</style>
