---
// Shared frame for the case study's charts and diagrams: the drawing, its
// caption, and the same data as text in a collapsed table.
//
// Each chart draws itself at three widths and marks each SVG with the
// size it was drawn for: .v-s (360 wide), .v-m (480) and .v-l (620). The
// frame is a size container and shows only the one that matches the
// column it sits in, so the SVG always fills the column (viewBox,
// width: 100%) and is scaled by at most a little either way. That keeps
// every piece of text at or above the 14px caption size without any
// sideways scrolling (brief, Part E20, E24):
//
//   column < 440px          .v-s   phones
//   440px ≤ column < 560px  .v-m   narrow desktop windows
//   column ≥ 560px          .v-l   desktop, tablets
//
// Only the displayed SVG reaches assistive tech; the others are
// display: none.
//
// Slots: default = the SVGs; "table" = <thead>/<tbody> for the data table.
import './figures.css';

const { caption, label } = Astro.props;
---

<figure class="chart">
  <div class="frame" role="group" aria-label={label}>
    <slot />
  </div>
  <figcaption class="cs-caption">{caption}</figcaption>
  <details class="cs-data">
    <summary>
      <svg class="cs-chevron" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      Show chart data
    </summary>
    <div class="table-wrap">
      <table class="table">
        <slot name="table" />
      </table>
    </div>
  </details>
</figure>

<style>
  .chart {
    margin: 0;
  }

  .frame {
    container-type: inline-size;
  }

  .frame > :global(svg) {
    display: none;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  @container (max-width: 439.98px) {
    .frame > :global(svg.v-s) {
      display: block;
    }
  }

  @container (min-width: 440px) and (max-width: 559.98px) {
    .frame > :global(svg.v-m) {
      display: block;
    }
  }

  @container (min-width: 560px) {
    .frame > :global(svg.v-l) {
      display: block;
    }
  }

  /* The data table wraps its text instead of scrolling. */
  .table-wrap {
    margin-top: var(--space-2);
  }

  .table {
    font-size: 14px;
  }

  /* Nocturne's table headers are all caps; this page keeps labels in
     sentence case. */
  .table :global(thead th) {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 13px;
    color: var(--color-neutral-500);
  }

  .table :global(tbody th) {
    text-transform: none;
    letter-spacing: normal;
    font-size: 14px;
    font-weight: 400;
    text-align: left;
    color: var(--color-neutral-200);
    vertical-align: top;
  }

  .table :global(td) {
    color: var(--color-neutral-300);
    vertical-align: top;
  }
</style>
