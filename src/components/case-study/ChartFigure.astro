---
// Shared frame for the case study's charts and diagrams: the drawing, its
// caption, and the same data as text in a collapsed table.
//
// The drawing scrolls sideways inside its own container once the space is
// narrower than `minWidth` (px), so the SVG's text never shrinks below
// legible size and the page itself never scrolls sideways. `label` names
// that scroll region for keyboard and screen reader users. `maxWidth`
// (px) keeps a small drawing from being scaled up past its natural size;
// it stays left-aligned.
//
// Where the figure sits (both columns or the body column) is decided by
// the page, not here; this component always fills the width it is given.
//
// Slots: default = the SVG; "table" = <thead>/<tbody> for the data table.
import './figures.css';

const { caption, label, minWidth = 0, maxWidth } = Astro.props;
---

<figure class="chart">
  <div class="frame" role="region" aria-label={label} tabindex="0" style={`--min-w: ${minWidth}px${maxWidth ? `; --max-w: ${maxWidth}px` : ''}`}>
    <slot />
  </div>
  <figcaption class="cs-caption">{caption}</figcaption>
  <details class="cs-data">
    <summary>
      <svg class="cs-chevron" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      Show chart data
    </summary>
    <div class="table-wrap">
      <table class="table">
        <slot name="table" />
      </table>
    </div>
  </details>
</figure>

<style>
  .chart {
    margin: 0;
  }

  .frame {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border-radius: var(--radius-md);
  }

  .frame > :global(svg) {
    display: block;
    width: 100%;
    min-width: var(--min-w);
    max-width: var(--max-w, none);
    height: auto;
    overflow: visible;
  }

  .table-wrap {
    overflow-x: auto;
    max-width: 66ch;
    margin-top: var(--space-2);
  }

  .table {
    font-size: 13px;
  }

  /* Nocturne's table headers are all caps; this page keeps labels in
     sentence case. */
  .table :global(thead th) {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 12px;
    color: var(--color-neutral-500);
    white-space: nowrap;
  }

  .table :global(tbody th) {
    text-transform: none;
    letter-spacing: normal;
    font-size: 13px;
    font-weight: 400;
    text-align: left;
    color: var(--color-neutral-200);
    vertical-align: top;
  }

  .table :global(td) {
    color: var(--color-neutral-300);
    vertical-align: top;
  }
</style>
