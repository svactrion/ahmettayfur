---
// C4: what an engaged free user costs per month, as ranges on one scale.
//
// Each bar is a measured part plus an optional estimated part laid end to
// end. The measured part is solid, the estimated part hatched. Each part's
// own uncertainty shows as a lighter stretch at the end of the bar: the
// measured range [measured[0], measured[1]], then the same width again at
// the far end once the estimate is added on top.
//
// Drawn at the three ChartFigure widths, each bar's label above it so the
// bars can use the full width. All text is left-aligned except the
// numbers under the tick marks.
//
// Props:
//   bars: [{ label, measured: [lo, hi], estimatedAdd, provenance }]
//   xMax, xStep              USD scale
//   legend: { measured, estimated }
//   caption, label
import ChartFigure from './ChartFigure.astro';
import { VARIANTS, textWidth, charsFor, wrap } from './chart-utils.js';

const { bars, xMax, xStep, legend, caption, label } = Astro.props;

const LINE = 19;
const BAR_H = 28;
const usd = (v) => `$${v.toFixed(2)}`;
const range = ([lo, hi]) => `$${lo.toFixed(2)}–${hi.toFixed(2)}`;
const ticks = Array.from({ length: Math.round(xMax / xStep) + 1 }, (_, i) => i * xStep);

const drawn = bars.map((bar) => {
  const [mLo, mHi] = bar.measured;
  const e = bar.estimatedAdd ?? 0;
  const total = [mLo + e, mHi + e];
  // [from, to, kind] segments, left to right.
  const segments = [
    [0, mLo, 'measured'],
    [mLo, mHi, 'measured range'],
  ];
  if (e > 0) {
    segments.push([mHi, total[0], 'estimated'], [total[0], total[1], 'estimated range']);
  }
  return { ...bar, total, segments };
});

function layout(W, name) {
  // Room right of the longest bar for its range label.
  const X1 = W - textWidth(range(drawn.at(-1).total), 16) - 18;
  const x = (v) => (v / xMax) * X1;
  let y = 50; // first label baseline, a clear step below the legend
  const rows = drawn.map((bar) => {
    const lines = wrap(bar.label, charsFor(W));
    const labelY = y;
    const barY = labelY + (lines.length - 1) * LINE + 12;
    y = barY + BAR_H + 34;
    return { bar, lines, labelY, barY };
  });
  const axisY = y - 6;
  return { W, H: axisY + 6, name, x, rows, axisY, gridTop: rows[0].barY - 8, hatch: `free-cost-hatch-${name}` };
}

const drawings = VARIANTS.map((v) => layout(v.width, v.name));
---

<ChartFigure caption={caption} label={label}>
  {
    drawings.map((d) => (
      <svg class={`free-cost v v-${d.name}`} viewBox={`0 0 ${d.W} ${d.H}`} role="img" aria-label={label}>
        <defs>
          <pattern id={d.hatch} width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect class="hatch-bg" width="8" height="8" />
            <line class="hatch-line" x1="0" y1="0" x2="0" y2="8" />
          </pattern>
        </defs>

        <g class="legend">
          <rect class="seg measured" x="0" y="2" width="22" height="14" rx="3" />
          <text x="30" y="15">
            {legend.measured}
          </text>
          <rect class="seg" fill={`url(#${d.hatch})`} x={52 + textWidth(legend.measured)} y="2" width="22" height="14" rx="3" />
          <text x={82 + textWidth(legend.measured)} y="15">
            {legend.estimated}
          </text>
        </g>

        {ticks.map((v) => (
          <g>
            <line class="grid" x1={d.x(v)} x2={d.x(v)} y1={d.gridTop} y2={d.axisY - 20} />
            <text class="tick" x={d.x(v)} y={d.axisY} text-anchor={v === 0 ? 'start' : 'middle'}>
              {usd(v)}
            </text>
          </g>
        ))}

        {d.rows.map(({ bar, lines, labelY, barY }) => (
          <g>
            {lines.map((line, li) => (
              <text class="bar-label" x="0" y={labelY + li * LINE}>
                {line}
              </text>
            ))}
            {bar.segments.map(([from, to, kind]) => (
              <rect
                class={`seg ${kind}`}
                fill={kind.startsWith('estimated') ? `url(#${d.hatch})` : undefined}
                x={d.x(from)}
                y={barY}
                width={Math.max(0, d.x(to) - d.x(from))}
                height={BAR_H}
              />
            ))}
            <line class="range-tick" x1={d.x(bar.total[0])} x2={d.x(bar.total[0])} y1={barY - 4} y2={barY + BAR_H + 4} />
            <line class="range-tick" x1={d.x(bar.total[1])} x2={d.x(bar.total[1])} y1={barY - 4} y2={barY + BAR_H + 4} />
            <text class="value" x={d.x(bar.total[1]) + 10} y={barY + BAR_H / 2 + 6}>
              {range(bar.total)}
            </text>
          </g>
        ))}
      </svg>
    ))
  }

  <Fragment slot="table">
    <thead>
      <tr>
        <th scope="col">Free user, 30 days</th>
        <th scope="col">Cost per month</th>
        <th scope="col">Provenance</th>
      </tr>
    </thead>
    <tbody>
      {
        drawn.map((bar) => (
          <tr>
            <th scope="row">{bar.label}</th>
            <td>{range(bar.total)}</td>
            <td>{bar.provenance}</td>
          </tr>
        ))
      }
    </tbody>
  </Fragment>
</ChartFigure>

<style>
  /* 15.5px is TEXT in chart-utils.js: the smallest size in any drawing. */
  svg text {
    font-family: var(--font-body);
    font-size: 15.5px;
    fill: var(--color-neutral-300);
  }

  .bar-label {
    fill: var(--color-neutral-200);
  }

  .tick {
    fill: var(--color-neutral-500);
    font-variant-numeric: tabular-nums;
  }

  .grid {
    stroke: var(--color-divider);
    stroke-width: 1;
  }

  .seg.measured {
    fill: var(--color-accent);
  }

  .seg.measured.range,
  .seg.estimated.range {
    opacity: 0.45;
  }

  .hatch-bg {
    fill: var(--color-accent-900);
  }

  .hatch-line {
    stroke: var(--color-accent-400);
    stroke-width: 3;
  }

  .range-tick {
    stroke: var(--color-neutral-300);
    stroke-width: 1.5;
  }

  .value {
    font-size: 16px;
    font-weight: 600;
    fill: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
</style>
