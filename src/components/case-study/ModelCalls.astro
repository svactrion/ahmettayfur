---
// C3: one block per user flow, its steps in order, and which of those
// steps call the language model. Model calls are filled boxes in the
// accent color; steps that stay on the device are outlined. A flow may
// carry one dashed note after its last step.
//
// Drawn at the three ChartFigure widths. At m and l the steps run left to
// right; at s (phones) they stack top to bottom, so the text keeps its
// size instead of shrinking (brief, Part E24). All text is left-aligned.
//
// Props:
//   flows: [{ name, calls, steps: [{ text, model: bool }], note?: text }]
//   legend: { model, device }
//   caption, label
import ChartFigure from './ChartFigure.astro';
import { VARIANTS, textWidth, charsFor, wrap, fill } from './chart-utils.js';

const { flows, legend, caption, label, ui } = Astro.props;

const LINE = 19; // line height inside boxes and notes
const PAD = 12; // text inset inside a box
const ARROW = 24; // room between boxes for an arrow
const callsText = (n) => (n === 1 ? ui.modelCalls.callOne : fill(ui.modelCalls.callMany, { n }));

function layout(W, stacked) {
  const maxSteps = Math.max(...flows.map((f) => f.steps.length));
  const boxW = stacked ? W : (W - (maxSteps - 1) * ARROW) / maxSteps;
  const chars = charsFor(boxW - 2 * PAD);
  const noteChars = charsFor(W - 2 * PAD);

  let y = 34; // below the legend
  const rows = flows.map((flow, r) => {
    const top = y + (r > 0 ? 26 : 0);
    const nameY = top + 18;
    let cursor = top + 34;
    const boxes = [];
    const arrows = [];

    if (stacked) {
      flow.steps.forEach((step, i) => {
        const lines = wrap(step.text, chars);
        const h = lines.length * LINE + 2 * PAD - 4;
        if (i > 0) {
          arrows.push({ x1: 22, y1: cursor - 20, x2: 22, y2: cursor - 4, dir: 'down' });
        }
        boxes.push({ x: 0, y: cursor, w: W, h, lines, model: step.model });
        cursor += h + 24;
      });
      cursor -= 24;
    } else {
      const wrapped = flow.steps.map((s) => wrap(s.text, chars));
      const h = Math.max(...wrapped.map((l) => l.length)) * LINE + 2 * PAD - 4;
      flow.steps.forEach((step, i) => {
        const x = i * (boxW + ARROW);
        if (i > 0) {
          arrows.push({ x1: x - ARROW + 5, y1: cursor + h / 2, x2: x - 5, y2: cursor + h / 2, dir: 'right' });
        }
        boxes.push({ x, y: cursor, w: boxW, h, lines: wrapped[i], model: step.model });
      });
      cursor += h;
    }

    let note = null;
    if (flow.note) {
      const last = boxes.at(-1);
      const lines = wrap(flow.note, noteChars);
      const noteTop = cursor + 18;
      const linkX = stacked ? 22 : last.x + PAD;
      note = {
        y: noteTop,
        h: lines.length * LINE + 2 * PAD - 4,
        lines,
        link: { x: linkX, y1: cursor + 2, y2: noteTop - 2 },
      };
      cursor = noteTop + note.h;
    }

    y = cursor;
    return { flow, top, nameY, boxes, arrows, note };
  });

  return { W, H: y + 2, rows };
}

const drawings = VARIANTS.map((v) => ({ ...v, ...layout(v.width, v.name === 's') }));

// The data table's Steps cell as one sentence. The step labels are
// capitalized for the diagram boxes; mid-sentence, every step after the
// first starts lowercase, by the page language's rules (Turkish I → ı).
const stepsText = (flow) =>
  flow.steps
    .map((s, i) => {
      const text = i === 0 ? s.text : s.text[0].toLocaleLowerCase(ui.locale) + s.text.slice(1);
      return s.model ? `${text}${ui.modelCalls.model}` : text;
    })
    .join(ui.then) + (flow.note ? `. ${flow.note}` : '');
---

<ChartFigure caption={caption} label={label} ui={ui}>
  {
    drawings.map((d) => (
      <svg class={`model-calls v v-${d.name}`} viewBox={`0 0 ${d.W} ${d.H}`} role="img" aria-label={label}>
        <g class="legend">
          <rect class="box model" x="0" y="2" width="22" height="16" rx="4" />
          <text x="30" y="15">
            {legend.model}
          </text>
          <rect class="box device" x={52 + textWidth(legend.model)} y="2" width="22" height="16" rx="4" />
          <text x={82 + textWidth(legend.model)} y="15">
            {legend.device}
          </text>
        </g>

        {d.rows.map((row, r) => (
          <g>
            {r > 0 && <line class="row-rule" x1="0" x2={d.W} y1={row.top - 13} y2={row.top - 13} />}
            <text class="flow-name" x="0" y={row.nameY}>
              {row.flow.name}
            </text>
            <text class={`flow-calls${row.flow.calls ? '' : ' none'}`} x={d.W} y={row.nameY} text-anchor="end">
              {callsText(row.flow.calls)}
            </text>

            {row.arrows.map((a) => (
              <g class="arrow">
                <line x1={a.x1} y1={a.y1} x2={a.x2} y2={a.y2} />
                {a.dir === 'right' ? (
                  <path d={`M ${a.x2 - 6} ${a.y2 - 5} L ${a.x2} ${a.y2} L ${a.x2 - 6} ${a.y2 + 5}`} />
                ) : (
                  <path d={`M ${a.x2 - 5} ${a.y2 - 6} L ${a.x2} ${a.y2} L ${a.x2 + 5} ${a.y2 - 6}`} />
                )}
              </g>
            ))}

            {row.boxes.map((b) => (
              <g>
                <rect class={`box ${b.model ? 'model' : 'device'}`} x={b.x} y={b.y} width={b.w} height={b.h} rx="8" />
                {b.lines.map((line, li) => (
                  <text class={`step-text${b.model ? ' on-model' : ''}`} x={b.x + PAD} y={b.y + PAD + 12 + li * LINE}>
                    {line}
                  </text>
                ))}
              </g>
            ))}

            {row.note && (
              <g class="note">
                <line class="note-link" x1={row.note.link.x} x2={row.note.link.x} y1={row.note.link.y1} y2={row.note.link.y2} />
                <rect x="0.75" y={row.note.y} width={d.W - 1.5} height={row.note.h} rx="8" />
                {row.note.lines.map((line, li) => (
                  <text x={PAD} y={row.note.y + PAD + 12 + li * LINE}>
                    {line}
                  </text>
                ))}
              </g>
            )}
          </g>
        ))}
      </svg>
    ))
  }

  <Fragment slot="table">
    <thead>
      <tr>
        <th scope="col">{ui.modelCalls.flow}</th>
        <th scope="col">{ui.modelCalls.steps}</th>
        <th scope="col">{ui.modelCalls.calls}</th>
      </tr>
    </thead>
    <tbody>
      {
        flows.map((flow) => (
          <tr>
            <th scope="row">{flow.name}</th>
            <td>{stepsText(flow)}</td>
            <td>{flow.calls}</td>
          </tr>
        ))
      }
    </tbody>
  </Fragment>
</ChartFigure>

<style>
  /* 15.5px is TEXT in chart-utils.js: the smallest size in any drawing. */
  svg text {
    font-family: var(--font-body);
    font-size: 15.5px;
    fill: var(--color-neutral-300);
  }

  .legend text {
    fill: var(--color-neutral-400);
  }

  .flow-name {
    font-size: 16.5px;
    font-weight: 600;
    fill: var(--color-text);
  }

  .flow-calls {
    fill: var(--color-accent-300);
  }

  .flow-calls.none {
    fill: var(--color-neutral-500);
  }

  .box.model {
    fill: var(--color-accent-800);
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }

  .box.device {
    fill: none;
    stroke: var(--color-neutral-600);
    stroke-width: 1.25;
  }

  .step-text.on-model {
    fill: var(--color-accent-100);
    font-weight: 500;
  }

  .arrow line,
  .arrow path {
    stroke: var(--color-neutral-500);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .row-rule {
    stroke: var(--color-divider);
    stroke-width: 1;
  }

  .note rect,
  .note-link {
    fill: none;
    stroke: var(--color-neutral-600);
    stroke-width: 1.25;
    stroke-dasharray: 4 4;
  }

  .note text {
    fill: var(--color-neutral-400);
  }
</style>
