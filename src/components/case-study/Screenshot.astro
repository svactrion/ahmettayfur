---
// C8 / C9: one app screenshot with its caption underneath. The page
// decides its width and whether text flows beside it (brief, Part E27);
// this component fills the width it is given. Caption and frame share
// the storyboard's styles (figures.css).
//
// Props: { src, width, height, alt, caption }
import './figures.css';

const { src, width, height, alt, caption } = Astro.props;
---

<figure class="screenshot">
  <img class="cs-shot" src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  <figcaption class="cs-caption">{caption}</figcaption>
</figure>

<style>
  .screenshot {
    margin: 0;
  }
</style>
