---
// C8 / C9: one app screenshot with its caption. The caption sits beside
// the image on wide screens and under it on narrow ones.
//
// Props: { src, width, height, alt, caption }
const { src, width, height, alt, caption } = Astro.props;
---

<figure class="screenshot">
  <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .screenshot {
    display: flex;
    align-items: flex-end;
    gap: clamp(20px, 3vw, 36px);
    margin: 0;
  }

  img {
    display: block;
    flex: none;
    width: 240px;
    height: auto;
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
    background: var(--color-surface);
  }

  figcaption {
    max-width: 32ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-neutral-300);
  }

  @media (max-width: 768px) {
    .screenshot {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    img {
      width: min(240px, 70vw);
    }
  }
</style>
