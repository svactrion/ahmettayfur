---
// C8 / C9: one app screenshot with its caption underneath. It sits in the
// body column (the page places it), at a fixed phone width, left-aligned
// with the body text. Caption and frame share the storyboard's styles
// (figures.css).
//
// Props: { src, width, height, alt, caption }
import './figures.css';

const { src, width, height, alt, caption } = Astro.props;
---

<figure class="screenshot">
  <img class="cs-shot" src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  <figcaption class="cs-caption">{caption}</figcaption>
</figure>

<style>
  .screenshot {
    width: min(288px, 100%);
    margin: 0;
  }
</style>
