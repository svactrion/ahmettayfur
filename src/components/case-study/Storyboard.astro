---
// C7: the first day as a row of real app screenshots, in order, each with
// its own one-line caption. Any number of frames: the row divides the
// width it is given evenly, so adding a frame is a data change only.
//
// Side by side on desktop; below the shared 768px breakpoint the row
// scrolls sideways inside its own container, one frame per snap point.
// Caption and frame styles are shared with the single screenshots
// (figures.css).
//
// Props:
//   frames: [{ src, width, height, alt, caption }]
//   label   names the list (and the scroll region)
import './figures.css';

const { frames, label } = Astro.props;
---

<div class="storyboard" role="region" aria-label={label} tabindex="0">
  <ol role="list" style={`--frames: ${frames.length}`}>
    {
      frames.map((f) => (
        <li>
          <figure>
            <img class="cs-shot" src={f.src} width={f.width} height={f.height} alt={f.alt} loading="lazy" decoding="async" />
            <figcaption class="cs-caption">{f.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .storyboard {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    border-radius: var(--radius-md);
  }

  ol {
    display: grid;
    grid-template-columns: repeat(var(--frames), minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
    scroll-snap-align: start;
  }

  figure {
    margin: 0;
  }

  @media (max-width: 768px) {
    ol {
      grid-template-columns: repeat(var(--frames), 200px);
    }
  }
</style>
