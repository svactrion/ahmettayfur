---
// C7: the first day as real app screenshots, in order, each with its own
// one-line caption. Adding a frame is a data change only.
//
// Desktop: a 2×2 grid in the body column (brief, Part E21). Below the
// shared 768px breakpoint: a scroll-snap row where each frame takes about
// three quarters of the width, so the next one peeks in from the edge and
// the row reads as scrollable (Part E24). Caption and frame styles are
// shared with the single screenshots (figures.css).
//
// Props:
//   frames: [{ src, width, height, alt, caption }]
//   label   names the list (and the scroll region)
import './figures.css';

const { frames, label } = Astro.props;
---

<div class="storyboard" role="region" aria-label={label} tabindex="0">
  <ol role="list">
    {
      frames.map((f) => (
        <li>
          <figure>
            <img class="cs-shot" src={f.src} width={f.width} height={f.height} alt={f.alt} loading="lazy" decoding="async" />
            <figcaption class="cs-caption">{f.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .storyboard {
    border-radius: var(--radius-md);
  }

  ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--space-8) * 2) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
  }

  figure {
    margin: 0;
  }

  @media (max-width: 768px) {
    .storyboard {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
    }

    ol {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 76%;
      gap: var(--space-6);
    }

    li {
      scroll-snap-align: start;
    }
  }
</style>
