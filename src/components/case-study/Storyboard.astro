---
// C7: the first day as a row of real app screenshots, in order, each with
// its own one-line caption. Any number of frames: the row sizes itself to
// the list, so adding a frame is a data change only.
//
// Side by side on desktop; below the shared 768px breakpoint the row
// scrolls sideways inside its own container, one frame per snap point.
//
// Props:
//   frames: [{ src, width, height, alt, caption }]
//   label   names the list (and the scroll region)
const { frames, label } = Astro.props;
---

<div class="storyboard" role="region" aria-label={label} tabindex="0">
  <ol role="list" style={`--frames: ${frames.length}`}>
    {
      frames.map((f) => (
        <li>
          <figure>
            <img src={f.src} width={f.width} height={f.height} alt={f.alt} loading="lazy" decoding="async" />
            <figcaption>{f.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .storyboard {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    border-radius: var(--radius-md);
  }

  ol {
    display: grid;
    grid-template-columns: repeat(var(--frames), minmax(180px, 240px));
    gap: clamp(20px, 3vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    scroll-snap-align: start;
  }

  figure {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
    background: var(--color-surface);
  }

  figcaption {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-neutral-300);
  }

  @media (max-width: 768px) {
    ol {
      grid-template-columns: repeat(var(--frames), 200px);
    }
  }
</style>
