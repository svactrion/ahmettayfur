---
// C7: the first day as real app screenshots, in order, each with its own
// one-line caption led by its frame number. Adding a frame is a data
// change only.
//
// Every frame is --cs-shot-w wide, the one screenshot width on the page
// (figures.css, brief Part E29); the layout changes around it instead of
// shrinking it (Part E30):
//   - a 2×2 grid, left-aligned with the body text, when the column holds
//     two frames and the gap (2 × 300 + 22.4 = 623px) and the screen is
//     768px or wider;
//   - otherwise a scroll-snap row, the next frame peeking in from the
//     edge so the row reads as scrollable.
//
// Props:
//   frames: [{ src, width, height, alt, caption }]
//   label   names the list (and the scroll region)
import './figures.css';

const { frames, label } = Astro.props;
---

<div class="storyboard" role="region" aria-label={label} tabindex="0">
  <ol role="list">
    {
      frames.map((f) => (
        <li>
          <figure>
            <img class="cs-shot" src={f.src} width={f.width} height={f.height} alt={f.alt} loading="lazy" decoding="async" />
            <figcaption class="cs-caption">{f.caption}</figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .storyboard {
    container-type: inline-size;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    border-radius: var(--radius-md);
  }

  /* Default: one row, frames side by side, scrolling. */
  ol {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--cs-shot-w);
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: frame;
  }

  li {
    min-width: 0;
    scroll-snap-align: start;
    counter-increment: frame;
  }

  figure {
    margin: 0;
  }

  /* Frame numbers: the frames are a sequence, and in the scrolling row
     only part of it is in view. Plain, in the caption's own style. */
  figcaption::before {
    content: counter(frame) '. ';
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 768px) {
    @container (min-width: 623px) {
      ol {
        grid-auto-flow: row;
        grid-template-columns: repeat(2, var(--cs-shot-w));
        gap: calc(var(--space-8) * 2) var(--space-8);
      }
    }
  }
</style>
