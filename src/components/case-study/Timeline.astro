---
// C2: the project from first commit to submission.
//
// Dates are placed on a true scale, so the quiet month between the MVP
// week and late August shows as empty track, and the September cluster
// shows as a cluster. Drawn at the three ChartFigure widths:
//
//   m, l  one row per event: date, label, then a horizontal time track
//         with the event's dot (or span) at its real position. The time
//         axis runs left to right; labels keep their full size.
//   s     vertical: the time axis runs down the left edge, labels are
//         laid out evenly in date order and joined to their marker by a
//         leader line; both run in the same order, so leaders never cross.
//
// All text is left-aligned.
//
// Props:
//   events: [{ date, start: 'YYYY-MM-DD', end?: 'YYYY-MM-DD', label }]
//   caption, label
import ChartFigure from './ChartFigure.astro';
import { VARIANTS, charsFor, wrap } from './chart-utils.js';

const { events, caption, label } = Astro.props;

const LINE = 19;
const day = (iso) => Date.UTC(...iso.split('-').map((n, i) => (i === 1 ? n - 1 : +n))) / 86400000;
const first = day(events[0].start);
const last = Math.max(...events.map((e) => day(e.end ?? e.start)));
const frac = (iso) => (day(iso) - first) / (last - first);
const isLast = (i) => i === events.length - 1;

function rowsLayout(W, name) {
  const DATE_W = 100; // fits the widest date, "21–22 Sep", in bold
  const LABEL_W = W >= 600 ? 250 : 190;
  const T0 = DATE_W + LABEL_W + 18; // track start
  const T1 = W - 8; // track end, leaving room for the dot
  const tx = (iso) => T0 + frac(iso) * (T1 - T0);
  let y = 30; // below the track's end labels
  const rows = events.map((e) => {
    const lines = wrap(e.label, charsFor(LABEL_W));
    const top = y;
    y += lines.length * LINE + 14;
    return { ...e, lines, top, mid: top + 12, x: tx(e.start), x2: e.end ? tx(e.end) : null };
  });
  return { kind: 'rows', name, W, H: y - 8, rows, DATE_W, T0, T1 };
}

function verticalLayout(W, name) {
  const VX = 10; // axis x
  const TEXT_X = 54;
  const GAP = 14;
  let cursor = 6;
  const rows = events.map((e) => {
    const lines = wrap(e.label, charsFor(W - TEXT_X));
    const top = cursor;
    cursor += (1 + lines.length) * LINE + GAP;
    return { ...e, lines, top };
  });
  const H = cursor - GAP + 6;
  const V0 = 12;
  const V1 = H - 12;
  const vy = (iso) => V0 + frac(iso) * (V1 - V0);
  return {
    kind: 'vertical',
    name,
    W,
    H,
    VX,
    TEXT_X,
    V0,
    V1,
    rows: rows.map((e) => ({ ...e, my: vy(e.start), my2: e.end ? vy(e.end) : null, ly: e.top + 12 })),
  };
}

const drawings = VARIANTS.map((v) => (v.name === 's' ? verticalLayout(v.width, v.name) : rowsLayout(v.width, v.name)));
---

<ChartFigure caption={caption} label={label}>
  {
    drawings.map((d) =>
      d.kind === 'rows' ? (
        <svg class={`timeline v v-${d.name}`} viewBox={`0 0 ${d.W} ${d.H}`} role="img" aria-label={label}>
          <text class="end-label" x={d.T0} y="16">
            {events[0].date}
          </text>
          <text class="end-label" x={d.T1} y="16" text-anchor="end">
            {events.at(-1).date}
          </text>
          <line class="guide" x1={d.T0} x2={d.T0} y1="24" y2={d.H} />
          <line class="guide" x1={d.T1} x2={d.T1} y1="24" y2={d.H} />
          {d.rows.map((e, i) => (
            <g class={isLast(i) ? 'event last' : 'event'}>
              {i > 0 && <line class="row-rule" x1="0" x2={d.W} y1={e.top - 8} y2={e.top - 8} />}
              <text class="date" x="0" y={e.top + 17}>
                {e.date}
              </text>
              {e.lines.map((line, li) => (
                <text class="label" x={d.DATE_W} y={e.top + 17 + li * LINE}>
                  {line}
                </text>
              ))}
              <line class="track" x1={d.T0} x2={d.T1} y1={e.mid} y2={e.mid} />
              {e.x2 ? (
                <rect class="span" x={e.x - 5} y={e.mid - 5} width={e.x2 - e.x + 10} height="10" rx="5" />
              ) : (
                <circle class="dot" cx={e.x} cy={e.mid} r="5.5" />
              )}
            </g>
          ))}
        </svg>
      ) : (
        <svg class={`timeline v v-${d.name}`} viewBox={`0 0 ${d.W} ${d.H}`} role="img" aria-label={label}>
          <line class="axis" x1={d.VX} x2={d.VX} y1={d.V0} y2={d.V1} />
          {d.rows.map((e, i) => (
            <g class={isLast(i) ? 'event last' : 'event'}>
              <polyline
                class="leader"
                points={`${d.VX + 9},${e.my} ${d.VX + 16},${e.my} ${d.TEXT_X - 12},${e.ly} ${d.TEXT_X - 6},${e.ly}`}
              />
              {e.my2 ? (
                <rect class="span" x={d.VX - 5} y={e.my - 5} width="10" height={e.my2 - e.my + 10} rx="5" />
              ) : (
                <circle class="dot" cx={d.VX} cy={e.my} r="5.5" />
              )}
              <text class="date" x={d.TEXT_X} y={e.top + 17}>
                {e.date}
              </text>
              {e.lines.map((line, li) => (
                <text class="label" x={d.TEXT_X} y={e.top + 17 + (li + 1) * LINE}>
                  {line}
                </text>
              ))}
            </g>
          ))}
        </svg>
      )
    )
  }

  <Fragment slot="table">
    <thead>
      <tr>
        <th scope="col">Date (2026)</th>
        <th scope="col">Event</th>
      </tr>
    </thead>
    <tbody>
      {
        events.map((e) => (
          <tr>
            <td>{e.date}</td>
            <td>{e.label}</td>
          </tr>
        ))
      }
    </tbody>
  </Fragment>
</ChartFigure>

<style>
  /* 15.5px is TEXT in chart-utils.js: the smallest size in any drawing. */
  text {
    font-family: var(--font-body);
    font-size: 15.5px;
  }

  .date {
    font-weight: 600;
    fill: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .label {
    fill: var(--color-neutral-300);
  }

  .end-label {
    fill: var(--color-neutral-500);
    font-variant-numeric: tabular-nums;
  }

  .axis {
    stroke: var(--color-neutral-700);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .track {
    stroke: var(--color-neutral-800);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .guide {
    stroke: var(--color-neutral-800);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .row-rule {
    stroke: var(--color-divider);
    stroke-width: 1;
    opacity: 0.6;
  }

  .leader {
    fill: none;
    stroke: var(--color-neutral-700);
    stroke-width: 1;
  }

  .dot {
    fill: var(--color-bg);
    stroke: var(--color-accent-400);
    stroke-width: 2;
  }

  .span {
    fill: var(--color-accent-700);
    stroke: var(--color-accent-400);
    stroke-width: 1.5;
  }

  .last .dot {
    fill: var(--color-accent);
    stroke: var(--color-accent-300);
  }

  .last .date {
    fill: var(--color-accent-300);
  }
</style>
