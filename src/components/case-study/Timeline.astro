---
// C2: the project from first commit to submission, as an ordered list.
//
// Order only, no scale (brief, Part E26): one continuous vertical line at
// the left, a dot per event, then the date in a fixed-width column and the
// label, so every label starts on the same edge and wraps in place at any
// width. The events come in two titled groups; the line runs unbroken
// through the second title, with nothing between the groups, so the
// unlogged weeks between them aren't drawn as idle time. The last event
// carries the accent.
//
// Semantic HTML rather than SVG: it is a list of dated events, so an
// <ol> gives screen readers the order and the count for free, the text
// is real text that wraps and scales with the reader's settings, and one
// layout serves every width without drawing variants.
//
// Props:
//   groups: [{ title, events: [{ date, label }] }]
//   caption, label
import ChartFigure from './ChartFigure.astro';

const { groups, caption, label, ui } = Astro.props;
const all = groups.flatMap((g) => g.events);
const lastEvent = all.at(-1);
---

<ChartFigure caption={caption} label={label} ui={ui}>
  <ol class="timeline" role="list">
    {
      groups.map((group, gi) => (
        <li class="group">
          <p class="group-title" id={`timeline-group-${gi + 1}`}>
            {group.title}
          </p>
          <ol class="events" role="list" aria-labelledby={`timeline-group-${gi + 1}`}>
            {group.events.map((e) => (
              <li class={e === lastEvent ? 'event last' : 'event'}>
                <span class="date">{e.date}</span>
                <span class="label">{e.label}</span>
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>

  <Fragment slot="table">
    <thead>
      <tr>
        <th scope="col">{ui.timeline.date}</th>
        <th scope="col">{ui.timeline.event}</th>
      </tr>
    </thead>
    <tbody>
      {
        all.map((e) => (
          <tr>
            <td>{e.date}</td>
            <td>{e.label}</td>
          </tr>
        ))
      }
    </tbody>
  </Fragment>
</ChartFigure>

<style>
  /* Geometry: text lines are 16px × 1.45 = 23.2px, so a dot centered on
     an event's first line sits 11.6px down. The line is drawn in
     segments, one per event and one per title (padding, not margin,
     keeps them touching); the first segment starts and the last one
     stops at a dot's center. */
  .timeline {
    --line-h: 23.2px;
    --dot: 12px;
    --dot-center: calc(var(--line-h) / 2);
    --rail: 6px; /* the line's center, from the left edge */
    --text-x: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 16px;
    line-height: 1.45;
  }

  .group,
  .events {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group-title,
  .event {
    position: relative;
    margin: 0;
    padding-left: var(--text-x);
  }

  .group-title::after,
  .event::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 1px);
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-neutral-700);
  }

  .group-title {
    padding-top: 18px;
    padding-bottom: 10px;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    color: var(--color-neutral-400);
  }

  /* The first title sits above where the line starts. */
  .group:first-child .group-title {
    padding-top: 0;
  }

  .group:first-child .group-title::after {
    display: none;
  }

  .event {
    display: grid;
    grid-template-columns: 6.25em minmax(0, 1fr);
    column-gap: 12px;
    padding-bottom: 12px;
  }

  .group:first-child .event:first-child::after {
    top: var(--dot-center);
  }

  .group:last-child .event:last-child {
    padding-bottom: 0;
  }

  .group:last-child .event:last-child::after {
    bottom: auto;
    height: var(--dot-center);
  }

  .event::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(var(--rail) - var(--dot) / 2);
    top: calc(var(--dot-center) - var(--dot) / 2);
    width: var(--dot);
    height: var(--dot);
    box-sizing: border-box;
    border-radius: 50%;
    border: 2px solid var(--color-accent-400);
    background: var(--color-bg);
  }

  .date {
    font-weight: 600;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .label {
    color: var(--color-neutral-300);
    text-align: left;
  }

  .last::before {
    border-color: var(--color-accent-300);
    background: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .last .date {
    color: var(--color-accent-300);
  }

  .last .label {
    color: var(--color-text);
  }
</style>
