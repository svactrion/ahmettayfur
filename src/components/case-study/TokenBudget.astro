---
// C6: two Daily Test output budgets on one token scale. Each track is the
// full output-token limit; the fill is the worst response measured under
// it, and the text says how much headroom was left.
//
// Props:
//   rows: [{ label, limit, worst }]
//   caption, label
import ChartFigure from './ChartFigure.astro';

const { rows, caption, label } = Astro.props;

// Drawn at phone width, so it fits a 375px screen without scrolling;
// on wide screens it keeps this natural size. Each row: label, track,
// then the numbers. Tracks share one token scale, so the longer limit
// draws the longer track.
const W = 400;
const X0 = 0;
const X1 = 400;
const TRACK_H = 18;
const PITCH = 88;
const H = rows.length * PITCH - 16;

const maxLimit = Math.max(...rows.map((r) => r.limit));
const x = (tokens) => X0 + (tokens / maxLimit) * (X1 - X0);
const n = (v) => v.toLocaleString('en-US');
const headroom = (r) => Math.round((1 - r.worst / r.limit) * 100);
---

<ChartFigure caption={caption} label={label} maxWidth={W}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} class="token-budget">
    {
      rows.map((r, i) => {
        const y = i * PITCH;
        return (
          <g>
            <text class="row-label" x={X0} y={y + 16}>
              {r.label}
            </text>
            <rect class="track" x={x(0)} y={y + 26} width={x(r.limit) - x(0)} height={TRACK_H} rx="4" />
            <rect class="fill" x={x(0)} y={y + 26} width={x(r.worst) - x(0)} height={TRACK_H} rx="4" />
            <text class="value" x={X0} y={y + 66}>
              {`${n(r.worst)} of ${n(r.limit)} tokens, ${headroom(r)}% headroom`}
            </text>
          </g>
        );
      })
    }
  </svg>

  <Fragment slot="table">
    <thead>
      <tr>
        <th scope="col">Version</th>
        <th scope="col">Limit</th>
        <th scope="col">Worst response</th>
        <th scope="col">Headroom</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td>{n(r.limit)}</td>
            <td>{n(r.worst)}</td>
            <td>{headroom(r)}%</td>
          </tr>
        ))
      }
    </tbody>
  </Fragment>
</ChartFigure>

<style>
  text {
    font-family: var(--font-body);
    font-size: 14px;
  }

  .row-label {
    font-size: 15px;
    fill: var(--color-neutral-200);
  }

  .value {
    font-size: 14px;
    fill: var(--color-neutral-400);
    font-variant-numeric: tabular-nums;
  }

  .track {
    fill: none;
    stroke: var(--color-neutral-600);
    stroke-width: 1.25;
  }

  .fill {
    fill: var(--color-accent);
  }
</style>
