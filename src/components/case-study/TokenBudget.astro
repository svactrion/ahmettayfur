---
// C6: two Daily Test output budgets on one token scale. Each track is the
// full output-token limit; the fill is the worst response measured under
// it, and the text says how much headroom was left.
//
// Drawn at the three ChartFigure widths. Each row: label, track, then
// the numbers, all left-aligned. Tracks share one token scale, so the
// longer limit draws the longer track.
//
// Props:
//   rows: [{ label, limit, worst }]
//   caption, label
import ChartFigure from './ChartFigure.astro';
import { VARIANTS } from './chart-utils.js';

const { rows, caption, label } = Astro.props;

const TRACK_H = 18;
const PITCH = 90;
const H = rows.length * PITCH - 18;

const maxLimit = Math.max(...rows.map((r) => r.limit));
const n = (v) => v.toLocaleString('en-US');
const headroom = (r) => Math.round((1 - r.worst / r.limit) * 100);
---

<ChartFigure caption={caption} label={label}>
  {
    VARIANTS.map(({ name, width: W }) => {
      const x = (tokens) => (tokens / maxLimit) * W;
      return (
        <svg class={`token-budget v v-${name}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
          {rows.map((r, i) => {
            const y = i * PITCH;
            return (
              <g>
                <text class="row-label" x="0" y={y + 16}>
                  {r.label}
                </text>
                <rect class="track" x="0.75" y={y + 27} width={x(r.limit) - 1.5} height={TRACK_H} rx="4" />
                <rect class="fill" x="0" y={y + 27} width={x(r.worst)} height={TRACK_H} rx="4" />
                <text class="value" x="0" y={y + 68}>
                  {`${n(r.worst)} of ${n(r.limit)} tokens, ${headroom(r)}% headroom`}
                </text>
              </g>
            );
          })}
        </svg>
      );
    })
  }

  <Fragment slot="table">
    <thead>
      <tr>
        <th scope="col">Version</th>
        <th scope="col">Limit</th>
        <th scope="col">Worst response</th>
        <th scope="col">Headroom</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td>{n(r.limit)}</td>
            <td>{n(r.worst)}</td>
            <td>{headroom(r)}%</td>
          </tr>
        ))
      }
    </tbody>
  </Fragment>
</ChartFigure>

<style>
  /* 15.5px is TEXT in chart-utils.js: the smallest size in any drawing. */
  text {
    font-family: var(--font-body);
    font-size: 15.5px;
  }

  .row-label {
    fill: var(--color-neutral-200);
  }

  .value {
    fill: var(--color-neutral-400);
    font-variant-numeric: tabular-nums;
  }

  .track {
    fill: none;
    stroke: var(--color-neutral-600);
    stroke-width: 1.25;
  }

  .fill {
    fill: var(--color-accent);
  }
</style>
