---
// Layout for every page except the GrammarLens legal pages.
// Those use Legal.astro so that changes made here can never affect them.
import { ClientRouter } from 'astro:transitions';
import { me } from '../data.js';
import '../styles/nocturne.css';
import '../styles/site.css';

const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname;
// Strip the trailing slash so the canonical URL matches the addresses given
// to Apple exactly (e.g. .../privacy, not .../privacy/).
const canonical = new URL(path.replace(/(.)\/$/, '$1'), Astro.site).href;
const year = new Date().getFullYear();

// On the home page the section links are plain hashes, so the browser just
// scrolls. From any other page they need the full path.
const home = path === '/' ? '' : '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="ahmettayfur.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#161826" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      // Arm motion styles only when JS runs and motion is welcome. Without this,
      // a JS failure would leave the page permanently invisible.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="shell">
      <header class="masthead">
        <nav class="nav" aria-label="Primary">
          <a class="nav-brand" href="/">
            <img src="/img/hero-face.webp" alt="" aria-hidden="true" width="32" height="32" />
            {me.name}
          </a>
          <a href="/products" aria-current={path.startsWith('/products') ? 'page' : undefined}>
            Products
          </a>
          <a href={`${home}#who`}>Who am I</a>
          <a href={`${home}#articles`}>Writing</a>
          <a href={`${home}#contact`}>Contact</a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="footer">
        <span>&copy; {year} {me.name}</span>
        <span class="footer-links">
          <a href="/products/grammarlens/privacy">Privacy</a>
          <a href="/products/grammarlens/terms">Terms</a>
          <a href="/products/grammarlens/support">Support</a>
        </span>
        <span>ahmettayfur.com</span>
      </footer>
    </div>

    <script is:inline>
      // Reveal each .row as it scrolls into view. Re-runs after every view
      // transition, because navigation replaces the DOM.
      function armReveals() {
        if (!document.documentElement.classList.contains('motion')) return;
        var rows = document.querySelectorAll('.row');
        if (!('IntersectionObserver' in window)) {
          rows.forEach(function (r) {
            r.classList.add('is-in');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        rows.forEach(function (r) {
          io.observe(r);
        });
      }

      armReveals();
      document.addEventListener('astro:page-load', armReveals);
    </script>
  </body>
</html>
